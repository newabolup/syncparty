# ==========================================
# SyncParty Environment Configuration
# ==========================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=5000

# Client Allowed CORS Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:5000

# Database URL
# Local SQLite default:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://syncparty:syncparty_secure_password_123@localhost:5432/syncparty_db?schema=public"

# Session & JWT Secret Key (generate a strong random string in production)
JWT_SECRET=replace_with_a_secure_random_production_secret_39182312

# Logging Level ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace')
LOG_LEVEL=info
